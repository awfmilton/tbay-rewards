# Copy to .env next to docker-compose.yml.
# Generate each secret with: openssl rand -hex 32

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=tbay
POSTGRES_PASSWORD=
POSTGRES_DB=tbay_rewards

# ── Server ───────────────────────────────────────────────────────────────────
# The public HTTPS origin your reverse proxy serves. Tracking, opt-in and
# share links are all built from this, so it must be the real external URL.
PUBLIC_URL=https://rewards.example.com
APP_PORT=4000

# Changing IDENTITY_SALT un-links members across retailers. Set once, keep it.
IDENTITY_SALT=
# TOKEN_SECRET is the same kind of commitment. As well as signing attribution
# cookies and opt-in tokens, it keys the wallet digests an erasure leaves
# behind -- so rotating it makes every already-erased spend intent
# unsettleable and every already-erased bridge withdrawal unpayable, silently.
# Set once, keep it; if it must be rotated after a leak, settle or release
# anything outstanding first.
TOKEN_SECRET=

# ── TBAY chain ───────────────────────────────────────────────────────────────
# 300 = zkSync Sepolia (pre-launch), 324 = zkSync Era mainnet.
TBAY_CHAIN_ID=300
TBAY_L2_CONTRACT=0x74eb73ACa939Fc911f79D9589e808f0207684D09
TBAY_L1_CONTRACT=0xC17e078E914aB6023dd48831358067d428409116
TBAY_RPC_URL=https://sepolia.era.zksync.dev

# Wallet holding CLAIMER_ROLE on the L2 contract. It only signs — it never sends
# transactions and needs no gas. Keep it out of version control.
TBAY_CLAIM_SIGNER_KEY=

# Lifetime ceiling on reward tokens, in wei. '0' is unlimited — fine on testnet,
# and refused on mainnet (the server logs an error and /health reports
# "misconfigured").
#
# L1 TBAY is verified on-chain as a fixed 1,000,000 supply with NO mint
# function, so every bridged withdrawal is released from a reserve you already
# hold. Set this to that reserve.
#
#   full million          1000000000000000000000000
#   600,000               600000000000000000000000
#
# Remember the L2 constructor also mints 1,000,000 to the deployer, and those
# tokens can bridge back against the same reserve. See docs/TOKEN.md.
TBAY_REWARD_SUPPLY_CAP_WEI=0

# mint = customers claim and mint; treasury = platform transfers from a wallet.
TBAY_SUPPLY_MODE=mint
TBAY_TREASURY_ADDRESS=
TBAY_TREASURY_KEY=

# ── Counter buffering ────────────────────────────────────────────────────────
# Fold heatmap and product counters in memory and flush them every few seconds
# instead of writing each increment inside the request transaction.
#
# A load review measured this as 50-100x fewer row versions under load, because
# the write rate stops being (visitors x samples) and becomes (distinct active
# cells per interval) — a thousand people on one page share the same few
# thousand cells. It also takes the hot-row locks off the request path.
#
# The cost is losing up to one interval of *analytics counters* on a crash. It
# never applies to the ledger, balances, orders or token claims, which stay
# exact and synchronous. Set to false if you would rather have every pointer
# sample durable than have the throughput.
TBAY_BUFFER_COUNTERS=true
TBAY_COUNTER_FLUSH_MS=3000

# ── Bridge rate ──────────────────────────────────────────────────────────────
# How many whole L2 TBAY one whole L1 TBAY is worth.
#   1       strict 1:1 — what the currently deployed L2 contract performs
#   10000   a 10,000,000,000 L2 supply backed by the 1,000,000 L1 supply
#
# WARNING: the deployed TBAYL2 scales by 10^9 (the 9→18 decimal conversion) and
# nothing else, so it is 1:1 regardless of this setting, and its MAX_SUPPLY caps
# L2 at 100,000,000. Setting this above 1 without redeploying a contract that
# applies the same rate makes every withdrawal release the wrong amount of L1.
# Preflight logs bridge_rate_not_one to say so. See docs/TOKEN.md.
TBAY_BRIDGE_L2_PER_L1=1

# How many of the 1,000,000 L1 TBAY are actually set aside for bridging.
# 0 assumes the full supply. Preflight checks that the reward cap above fits
# inside (rate x reserve) and refuses to boot a mainnet chain that does not.
TBAY_L1_RESERVE_TOKENS=0

# Required before any L1 release can be recorded -- and before a burned
# withdrawal can be rejected, which is the only way to close one out. Left
# empty, both routes answer 503 and a customer whose L2 tokens are already
# burned has no path to their L1 tokens at all. Generate one with
# `openssl rand -hex 32` before enabling the bridge.
BRIDGE_OPERATOR_TOKEN=

# ── thirdweb ─────────────────────────────────────────────────────────────────
# Enables in-app, social and smart-account wallets in the storefront UI.
THIRDWEB_CLIENT_ID=

# ── Email ────────────────────────────────────────────────────────────────────
# log = write to the container log, smtp = send through SMTP_URL.
EMAIL_TRANSPORT=log
EMAIL_FROM_NAME=TBAY Rewards
EMAIL_FROM_ADDRESS=no-reply@tbay.tk
SMTP_URL=
