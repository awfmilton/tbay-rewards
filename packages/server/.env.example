# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
PUBLIC_URL=https://rewards.tbay.tk
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/tbay_rewards
DATABASE_POOL_SIZE=10
DATABASE_SSL=false

# ── Secrets (generate with: openssl rand -hex 32) ────────────────────────────
# Salts the platform-wide member email hash. Changing it un-links members across
# retailers, so set it once and keep it.
IDENTITY_SALT=
# Signs attribution cookies, opt-in tokens and recovery links.
TOKEN_SECRET=

# ── Tracking ─────────────────────────────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=30
MAX_HEATMAP_POINTS_PER_BATCH=500
MAX_EVENTS_PER_BATCH=100
INGEST_RATE_PER_MINUTE=600
ADMIN_RATE_PER_MINUTE=300

# ── Abandoned carts ──────────────────────────────────────────────────────────
CART_ABANDON_AFTER_MINUTES=60
# Hours after abandonment at which each recovery email goes out.
CART_RECOVERY_STAGE_HOURS=1,24,72

# ── Writer commissions ───────────────────────────────────────────────────────
COMMISSION_ATTRIBUTION_WINDOW_DAYS=30
COMMISSION_HOLD_DAYS=30
COMMISSION_DEFAULT_RATE_BPS=500

# ── Rewards / token economics ────────────────────────────────────────────────
POINTS_PER_TOKEN=100
MIN_REDEEM_POINTS=100
CLAIM_TTL_MINUTES=60
CREDIT_CENTS_PER_TOKEN=100
SPEND_TTL_MINUTES=60

# ── TBAY chain ───────────────────────────────────────────────────────────────
# 300 = zkSync Sepolia (pre-launch), 324 = zkSync Era mainnet.
TBAY_CHAIN_ID=300
TBAY_L2_CONTRACT=0x74eb73ACa939Fc911f79D9589e808f0207684D09
TBAY_L1_CONTRACT=0xC17e078E914aB6023dd48831358067d428409116
TBAY_RPC_URL=https://sepolia.era.zksync.dev
# Private key of a wallet holding CLAIMER_ROLE on the L2 contract. Signing only —
# it never needs to hold gas. Keep it in a secrets manager, never in the repo.
TBAY_CLAIM_SIGNER_KEY=

# ── Email ────────────────────────────────────────────────────────────────────
# log = write to the application log (dev), smtp = send via SMTP_URL.
EMAIL_TRANSPORT=log
EMAIL_FROM_NAME=TBAY Rewards
EMAIL_FROM_ADDRESS=no-reply@tbay.tk
SMTP_URL=smtps://user:password@smtp.example.com:465
